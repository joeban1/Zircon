<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A one-off tool, deliberately its OWN project.

    It references the game client's RenderingCore.dll and drags System.Drawing and BCnEncoder in
    with it. None of that belongs in the bot: MirBot runs unattended for hours and must not carry a
    graphics-adjacent dependency it uses once, or fail to start because the client folder moved.

    Run it when the client's Data folder changes, and never otherwise.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>IconExport</AssemblyName>
    <RootNamespace>IconExport</RootNamespace>

    <!-- Only so reflection can walk RenderingCore's type list without tripping over a
         WinForms-derived type. Nothing here opens a window. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <!-- The client's own renderer. Referenced, never shipped: the tool is run from beside the
         client install, which already has it and its BCnEncoder dependency. -->
    <Reference Include="RenderingCore">
      <HintPath>G:\Program Files (x86)\Mir3\Home Server\Client\RenderingCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
